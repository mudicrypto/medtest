# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your values never reach GitHub.

# From Supabase: Project Settings → API (or "API Keys").
# Both are safe to expose to the browser; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# The public address of the site, used in links inside emails.
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEVER put the secret / service_role key in a NEXT_PUBLIC_ variable.
